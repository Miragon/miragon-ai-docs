---
// The site's button, as the header's "Talk to us": a pill with the label
// and an arrow, the arrow slides on hover. `blue` (the default) is the CI
// button for a band's primary action; `black` sits on blue surfaces such as
// the CtaBox. External links open in a new tab.
import Icon from "./Icon.astro"

interface Props {
  href: string
  label: string
  variant?: "blue" | "black"
}

const { href, label, variant = "blue" } = Astro.props
const external = /^https?:\/\//.test(href)
---

<a
  class:list={["pill", variant]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
>
  {label}
  <Icon name="arrow" size={18} />
</a>

<style>
  /* Each rule starts with :root. astro.config.mjs makes Astro scope these styles
     with :where(), which adds no specificity; the extra class keeps them
     above the page text's element rules (.prose a, .prose ul, .prose p,
     .prose li + li in styles/website.css), which they reset. */
  :root .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px 12px 24px;
    border-radius: var(--cd-radius-pill);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--cd-motion-base) var(--cd-ease);
  }
  :root .pill :global(svg) {
    flex: none;
    transition: transform var(--cd-motion-base) var(--cd-ease);
  }
  :root .pill:hover :global(svg) {
    transform: translateX(3px);
  }
  :root .pill:focus-visible {
    outline: 2px solid var(--cd-weiss);
    outline-offset: 3px;
  }
  :root .blue {
    background: var(--site-button-bg);
    color: var(--site-button-text);
  }
  :root .blue:hover {
    background: var(--site-button-bg-hover);
    color: var(--site-button-text);
  }
  :root .black {
    background: var(--cd-schwarz);
    color: var(--cd-weiss);
  }
  :root .black:hover {
    background: color-mix(in srgb, var(--cd-weiss) 16%, var(--cd-schwarz));
    color: var(--cd-weiss);
  }
</style>
