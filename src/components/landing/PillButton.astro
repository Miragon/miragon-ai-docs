---
// The miragon.io button: a pill with the label and a green circle carrying
// an arrow. `dark` on light grounds, `light` on dark or blue grounds,
// `outline` as the quieter second action. External links open in a new tab.
import Icon from "./Icon.astro"

interface Props {
  href: string
  label: string
  variant?: "dark" | "light" | "outline"
}

const { href, label, variant = "dark" } = Astro.props
const external = /^https?:\/\//.test(href)
---

<a
  class:list={["pill", variant]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
>
  <span class="label">{label}</span>
  <span class="circle">
    <Icon name="arrow" size={18} />
  </span>
</a>

<style>
  /* Each rule starts with :root. Starlight makes Astro scope these styles
     with :where(), which adds no specificity; the extra class keeps them
     above the page text's element rules (.prose a, .prose ul, .prose p,
     .prose li + li in styles/website.css), which they reset. */
  :root .pill {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 5px 5px 5px 24px;
    border: 1px solid transparent;
    border-radius: var(--cd-radius-pill);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--cd-motion-base) var(--cd-ease),
      border-color var(--cd-motion-base) var(--cd-ease),
      color var(--cd-motion-base) var(--cd-ease);
  }
  :root .circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--cd-gruen);
    color: var(--cd-schwarz);
    transition: transform var(--cd-motion-base) var(--cd-ease);
  }
  :root .pill:hover .circle {
    transform: translateX(3px);
  }
  :root .pill:focus-visible {
    outline: 2px solid var(--cd-blau-hell);
    outline-offset: 3px;
  }
  :root .dark {
    background: var(--cd-schwarz);
    color: var(--cd-weiss);
  }
  :root .dark:hover {
    background: var(--cd-blau);
  }
  :root .light {
    background: var(--cd-weiss);
    color: var(--cd-schwarz);
  }
  :root .light:hover {
    background: var(--cd-gruen);
  }
  :root .light:hover .circle {
    background: var(--cd-schwarz);
    color: var(--cd-weiss);
  }
  :root .outline {
    border-color: var(--l-card-border);
    background: transparent;
    color: var(--l-text);
  }
  :root .outline .circle {
    background: var(--l-tile-muted-bg);
    color: var(--l-text);
  }
  :root .outline:hover {
    border-color: var(--cd-gruen);
    background: var(--cd-gruen);
    color: var(--cd-schwarz);
  }
</style>
