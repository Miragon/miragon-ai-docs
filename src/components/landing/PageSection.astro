---
// A full-width band of a website page: eyebrow, title and intro, then the
// content (slot) in the 1152px container. Bands alternate the ground with
// `tone`. Scaffold: plain markup.
interface Props {
  id?: string
  eyebrow?: string
  title?: string
  intro?: string
  tone?: "plain" | "tint" | "dark"
  align?: "left" | "center"
}

const { id, eyebrow, title, intro, tone = "plain", align = "left" } = Astro.props
---

<section id={id} class:list={["page-section", `tone-${tone}`, `align-${align}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  {title && <h2>{title}</h2>}
  {intro && <p class="intro">{intro}</p>}
  <div class="content">
    <slot />
  </div>
</section>
