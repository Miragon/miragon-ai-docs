---
// The one source of function icons on the website pages: Lucide (CI rule
// B9), drawn with the CI's heavier stroke. Pages name an icon by its key in
// icons.ts, so every page draws from the same set. No AI symbolism
// (sparkles, robots, brains: CI rule U4); pick the icon of the concrete
// function. Decorative: hidden from assistive technology.
//
// One import per icon (not the @lucide/astro barrel, which loads all of
// Lucide). Deprecated Lucide names import the file they now point to:
// CircleHelp is circle-question-mark, History is rotate-ccw-clock.
import { ICONS, type IconName } from "./icons"
import Activity from "@lucide/astro/icons/activity"
import ArrowRight from "@lucide/astro/icons/arrow-right"
import Ban from "@lucide/astro/icons/ban"
import BookOpen from "@lucide/astro/icons/book-open"
import Boxes from "@lucide/astro/icons/boxes"
import Bug from "@lucide/astro/icons/bug"
import Cable from "@lucide/astro/icons/cable"
import ChartColumn from "@lucide/astro/icons/chart-column"
import Check from "@lucide/astro/icons/check"
import CircleCheck from "@lucide/astro/icons/circle-check"
import CircleHelp from "@lucide/astro/icons/circle-question-mark"
import ClipboardCheck from "@lucide/astro/icons/clipboard-check"
import Clock from "@lucide/astro/icons/clock"
import Code from "@lucide/astro/icons/code"
import Cog from "@lucide/astro/icons/cog"
import Container from "@lucide/astro/icons/container"
import Database from "@lucide/astro/icons/database"
import ExternalLink from "@lucide/astro/icons/external-link"
import Eye from "@lucide/astro/icons/eye"
import FileCode from "@lucide/astro/icons/file-code"
import FileText from "@lucide/astro/icons/file-text"
import FolderTree from "@lucide/astro/icons/folder-tree"
import Gauge from "@lucide/astro/icons/gauge"
import GitBranch from "@lucide/astro/icons/git-branch"
import GitMerge from "@lucide/astro/icons/git-merge"
import GitPullRequest from "@lucide/astro/icons/git-pull-request"
import Globe from "@lucide/astro/icons/globe"
import Handshake from "@lucide/astro/icons/handshake"
import History from "@lucide/astro/icons/rotate-ccw-clock"
import Inbox from "@lucide/astro/icons/inbox"
import KeyRound from "@lucide/astro/icons/key-round"
import Layers from "@lucide/astro/icons/layers"
import LayoutDashboard from "@lucide/astro/icons/layout-dashboard"
import Library from "@lucide/astro/icons/library"
import Link from "@lucide/astro/icons/link"
import ListChecks from "@lucide/astro/icons/list-checks"
import Lock from "@lucide/astro/icons/lock"
import LucideMap from "@lucide/astro/icons/map"
import MessageSquare from "@lucide/astro/icons/message-square"
import MessagesSquare from "@lucide/astro/icons/messages-square"
import Monitor from "@lucide/astro/icons/monitor"
import Network from "@lucide/astro/icons/network"
import Package from "@lucide/astro/icons/package"
import PenTool from "@lucide/astro/icons/pen-tool"
import Play from "@lucide/astro/icons/play"
import Plug from "@lucide/astro/icons/plug"
import Puzzle from "@lucide/astro/icons/puzzle"
import RefreshCw from "@lucide/astro/icons/refresh-cw"
import Route from "@lucide/astro/icons/route"
import Scale from "@lucide/astro/icons/scale"
import Search from "@lucide/astro/icons/search"
import Server from "@lucide/astro/icons/server"
import Share2 from "@lucide/astro/icons/share-2"
import ShieldCheck from "@lucide/astro/icons/shield-check"
import Target from "@lucide/astro/icons/target"
import Terminal from "@lucide/astro/icons/terminal"
import Ticket from "@lucide/astro/icons/ticket"
import TriangleAlert from "@lucide/astro/icons/triangle-alert"
import UserCheck from "@lucide/astro/icons/user-check"
import Users from "@lucide/astro/icons/users"
import Workflow from "@lucide/astro/icons/workflow"
import Wrench from "@lucide/astro/icons/wrench"
import X from "@lucide/astro/icons/x"

interface Props {
  name: IconName
  /** Default 22 (px). */
  size?: number
  /** Default 2.5, the CI's heavier stroke. */
  stroke?: number
}

type LucideName = Exclude<(typeof ICONS)[IconName], "Github">

// Keyed by the Lucide name icons.ts gives each key.
const LUCIDE: Record<LucideName, typeof ArrowRight> = {
  Activity,
  ArrowRight,
  Ban,
  BookOpen,
  Boxes,
  Bug,
  Cable,
  ChartColumn,
  Check,
  CircleCheck,
  CircleHelp,
  ClipboardCheck,
  Clock,
  Code,
  Cog,
  Container,
  Database,
  ExternalLink,
  Eye,
  FileCode,
  FileText,
  FolderTree,
  Gauge,
  GitBranch,
  GitMerge,
  GitPullRequest,
  Globe,
  Handshake,
  History,
  Inbox,
  KeyRound,
  Layers,
  LayoutDashboard,
  Library,
  Link,
  ListChecks,
  Lock,
  Map: LucideMap,
  MessageSquare,
  MessagesSquare,
  Monitor,
  Network,
  Package,
  PenTool,
  Play,
  Plug,
  Puzzle,
  RefreshCw,
  Route,
  Scale,
  Search,
  Server,
  Share2,
  ShieldCheck,
  Target,
  Terminal,
  Ticket,
  TriangleAlert,
  UserCheck,
  Users,
  Workflow,
  Wrench,
  X,
}

const { name, size = 22, stroke = 2.5 } = Astro.props
const lucideName = ICONS[name]
const Lucide = lucideName === "Github" ? undefined : LUCIDE[lucideName]
// Fail the build, not the page: a key without an icon would render nothing.
if (lucideName !== "Github" && !Lucide) {
  throw new Error(`landing/Icon.astro: no Lucide icon for "${name}" (${lucideName})`)
}
// Github: Lucide dropped its brand icons, so @lucide/astro has none. The
// paths below are lucide-vue-next 1.0.0's, which the VitePress site drew,
// with the attributes Lucide sets on every icon.
---

{Lucide ? (
  <Lucide size={size} stroke-width={stroke} aria-hidden="true" focusable="false" />
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={stroke}
    stroke-linecap="round"
    stroke-linejoin="round"
    class="lucide lucide-github"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
    <path d="M9 18c-4.51 2-5-2-7-2" />
  </svg>
)}
