---
// Icon, title and text per item, in 1 to 3 columns. Scaffold: a plain list.
import type { Feature } from "../../data/schemas"

interface Props {
  items: Feature[]
  columns?: 1 | 2 | 3
}

const { items, columns = 2 } = Astro.props
---

<ul class:list={["features", `cols-${columns}`]}>
  {items.map((item) => (
    <li>
      {item.title}
      {item.text && <p>{item.text}</p>}
    </li>
  ))}
</ul>
