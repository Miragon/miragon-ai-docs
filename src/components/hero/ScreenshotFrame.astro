---
// A screenshot of the real product as a tool page's hero artefact, in a
// plain browser frame with the address it was taken from. Data comes from
// the page's frontmatter (artefact.src, alt, url, caption). Images live in
// public/screens/. The hero column is narrow, so the image links to its
// full size.
interface Props {
  src: string
  alt: string
  url?: string
  caption?: string
}

const { src, alt, url, caption } = Astro.props
---

<figure class="shot">
  <div class="frame">
    <div class="bar">
      <span class="dots" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
      </span>
      {url && <span class="url">{url}</span>}
    </div>
    <a class="zoom" href={src} target="_blank" rel="noopener">
      <img src={src} alt={alt} loading="eager" decoding="async" />
      <span class="hint">Open full size ↗</span>
    </a>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
    text-align: left;
  }
  .frame {
    border: 1px solid var(--cd-kontur);
    border-radius: var(--cd-radius-md);
    background: var(--site-bg-alt);
    overflow: hidden;
    box-shadow: var(--cd-shadow-3);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--site-divider);
  }
  .dots {
    display: inline-flex;
    gap: 6px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--site-gray-1);
  }
  .url {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--site-font-mono);
    font-size: 11.5px;
    color: var(--site-text-2);
  }
  .zoom {
    position: relative;
    display: block;
    text-decoration: none;
  }
  img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 4px 10px;
    border-radius: var(--cd-radius-pill);
    background: var(--cd-schwarz);
    color: var(--cd-weiss);
    font-size: 12px;
    opacity: 0;
    transition: opacity var(--cd-motion-fast) var(--cd-ease);
  }
  .zoom:hover .hint,
  .zoom:focus-visible .hint {
    opacity: 1;
  }
  .zoom:focus-visible {
    outline: 2px solid var(--cd-blau-hell);
    outline-offset: -2px;
  }
  figcaption {
    margin-top: 10px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--site-text-2);
  }
</style>
