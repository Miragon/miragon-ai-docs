---
// Pulse's hero artefact: an MCP conversation that shows the product's thesis
// in one frame. A plain-language question about running BPMN processes is
// answered by a rendered widget instead of a wall of text. The numbers are a
// snapshot of the public playground on 2026-10-13, 14:04 UTC (read-only call
// camunda7_incidents_data on server 0.20.0: 112 open incidents, all
// failedJob, miraveloLeasing 61, assessCreditworthiness 51). The engine
// reseeds every night and live traffic adds incidents, so the live numbers
// move; the timestamp next to "Pulse" says when the snapshot was taken.
// "Assess in chat" is the hand-off label of the real incidents widget. Pulse
// is the MCP server from Miragon/miragon-ai.
//
// The turns come in one after the other and the bars fill (CSS only; with
// prefers-reduced-motion everything shows at once).

// Clicking the input opens the real playground in the MCP inspector, the
// same destination as the page's "Try the playground" button.
const INSPECTOR_URL =
  "https://inspector.manufact.com/inspector?server=https%3A%2F%2Fmiragon-ai-playground.fly.dev%2Fmcp&tab=chat"
---

<div class="convo">
  <div class="win">
    <div class="bar">
      <span class="live">
        <span class="dot"></span>playground
      </span>
      <span class="host">miragon-ai-playground.fly.dev</span>
    </div>

    <div class="body">
      <div class="turn user" style="--i: 0">
        <span class="who">You</span>
        <p class="msg">Which processes have open incidents right now?</p>
      </div>

      <div class="turn asst" style="--i: 1">
        <span class="who">
          Pulse <span class="when">· 2026-10-13, 14:04 UTC</span>
        </span>
        <p class="line">
          Across 2 process definitions, <b>112 open incidents</b>, all of them failed jobs.
        </p>

        <div class="widget">
          <div class="w-head">
            <span class="w-title">Open incidents</span>
            <span class="w-total">112</span>
          </div>
          <div class="w-row" style="--j: 0">
            <span class="pk">miraveloLeasing</span>
            <span class="track">
              <span class="fill" style="width: 54%"></span>
            </span>
            <span class="n">61</span>
          </div>
          <div class="w-row" style="--j: 1">
            <span class="pk">assessCreditworthiness</span>
            <span class="track">
              <span class="fill" style="width: 46%"></span>
            </span>
            <span class="n">51</span>
          </div>
          <div class="w-foot">
            <span class="tag">all failedJob</span>
            <span class="act">Assess in chat →</span>
          </div>
        </div>
      </div>
    </div>

    <a class="input" href={INSPECTOR_URL} target="_blank" rel="noopener noreferrer">
      <span class="caret"></span>
      <span class="ph">Ask a follow-up…</span>
      <span class="go" aria-hidden="true">
        ↗
      </span>
    </a>
  </div>
</div>

<style>
  /* Colours come from the site's roles (styles/tokens.css → CI tokens):
     --site-accent (green on the dark ground, per the CI) marks the
     assistant and everything interactive, the brand gradient only the
     window's top edge. */
  .convo {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
    /* The hero centres its text below 960px; a chat reads left-aligned. */
    text-align: left;
  }

  .win {
    position: relative;
    border: 1px solid var(--site-divider);
    border-radius: var(--cd-radius-lg);
    background: var(--site-bg-soft);
    overflow: hidden;
    box-shadow: var(--cd-shadow-3);
  }
  /* Brand gradient across the top edge */
  .win::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--cd-gradient-brand);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 16px;
    border-bottom: 1px solid var(--site-divider);
    font-family: var(--site-font-mono);
    font-size: 11.5px;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--site-text-2);
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cd-gruen);
    animation: hc-pulse 2s ease-in-out infinite;
  }
  .host {
    color: var(--site-text-3);
  }

  .body {
    padding: 20px 18px 8px;
  }

  /* The turns come in one after the other. */
  .turn {
    animation: hc-turn-in 0.5s ease both;
    animation-delay: calc(var(--i) * 0.5s + 0.1s);
  }

  .who {
    display: block;
    margin-bottom: 6px;
    font-family: var(--site-font-mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--site-text-3);
  }
  .turn.asst .who {
    color: var(--site-accent);
  }
  /* When the snapshot was taken: the numbers are not live */
  .when {
    color: var(--site-text-3);
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .turn.user {
    margin-bottom: 20px;
  }
  .msg {
    margin: 0;
    display: inline-block;
    padding: 10px 14px;
    border-radius: 12px 12px 12px 4px;
    background: var(--site-bg-elv);
    border: 1px solid var(--site-divider);
    color: var(--site-text-1);
    font-size: 14px;
    line-height: 1.45;
  }

  .line {
    margin: 0 0 12px;
    color: var(--site-text-2);
    font-size: 14px;
    line-height: 1.5;
  }
  .line b {
    color: var(--site-text-1);
    font-weight: 600;
  }

  /* Rendered "widget" card, mirroring the real incident widgets */
  .widget {
    border: 1px solid var(--site-divider);
    border-radius: var(--cd-radius-md);
    background: var(--site-bg-elv);
    padding: 14px 16px;
  }
  .w-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .w-title {
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--site-text-2);
  }
  .w-total {
    font-family: var(--site-font-mono);
    font-size: 18px;
    font-weight: 600;
    color: var(--site-text-1);
  }
  .w-row {
    display: grid;
    grid-template-columns: 1fr 72px auto;
    align-items: center;
    gap: 12px;
    padding: 7px 0;
  }
  .pk {
    font-family: var(--site-font-mono);
    font-size: 12.5px;
    color: var(--site-text-1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .track {
    height: 6px;
    border-radius: var(--cd-radius-pill);
    background: var(--site-gray-soft);
    overflow: hidden;
  }
  /* Incidents are an error state: the CI's functional danger colour. The
     bars fill after the answer is in. */
  .fill {
    display: block;
    height: 100%;
    border-radius: var(--cd-radius-pill);
    background: var(--cd-danger);
    transform-origin: left;
    animation: hc-fill 0.7s var(--cd-ease) both;
    animation-delay: calc(1.1s + var(--j) * 0.12s);
  }
  .n {
    font-family: var(--site-font-mono);
    font-size: 13px;
    color: var(--site-text-1);
    text-align: right;
  }
  /* On phones the bar moves below the process key, so the full key fits. */
  @media (max-width: 479px) {
    .w-row {
      grid-template-columns: 1fr auto;
      row-gap: 6px;
    }
    .pk {
      grid-column: 1;
      grid-row: 1;
    }
    .n {
      grid-column: 2;
      grid-row: 1;
    }
    .track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
  .w-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--site-divider);
  }
  .tag {
    font-family: var(--site-font-mono);
    font-size: 11px;
    color: var(--site-text-3);
  }
  .act {
    font-size: 12px;
    font-weight: 600;
    color: var(--site-accent);
  }

  .input {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 12px 14px 16px;
    padding: 11px 14px;
    border: 1px solid var(--site-border);
    border-radius: var(--cd-radius-pill);
    background: var(--site-bg);
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color var(--cd-motion-fast) var(--cd-ease),
      background var(--cd-motion-fast) var(--cd-ease);
  }
  .input:hover {
    border-color: var(--site-accent);
    background: var(--site-bg-alt);
  }
  .caret {
    width: 2px;
    height: 15px;
    background: var(--site-accent);
    animation: hc-blink 1.1s step-end infinite;
  }
  .ph {
    font-size: 13px;
    color: var(--site-text-3);
    transition: color var(--cd-motion-fast) var(--cd-ease);
  }
  .input:hover .ph {
    color: var(--site-text-2);
  }
  .go {
    margin-left: auto;
    font-size: 13px;
    color: var(--site-text-3);
    transition: color var(--cd-motion-fast) var(--cd-ease);
  }
  .input:hover .go {
    color: var(--site-accent);
  }

  @keyframes hc-turn-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  @keyframes hc-fill {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes hc-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  @keyframes hc-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .turn,
    .fill,
    .dot,
    .caret {
      animation: none;
    }
  }
</style>
