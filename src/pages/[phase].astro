---
// The five phase pages (/analyse/ ...), from src/content/phases/<phase>.mdx:
// one column of text, the page's own h1 included.
import { getCollection, render, type CollectionEntry } from "astro:content"
import Website from "../layouts/Website.astro"
import { WEBSITE_COMPONENTS } from "../components/landing"

export async function getStaticPaths() {
  const phases = await getCollection("phases")
  return phases.map((entry) => ({ params: { phase: entry.id }, props: { entry } }))
}

interface Props {
  entry: CollectionEntry<"phases">
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<Website title={entry.data.title} description={entry.data.description}>
  <article class="prose phase">
    <Content components={WEBSITE_COMPONENTS} />
  </article>
</Website>

<style>
  /* The text's 760px measure plus the page gutter. */
  .phase {
    max-width: calc(760px + 2 * 24px);
    margin: 0 auto;
    padding: 48px 24px 96px;
  }
</style>
