---
// Layout of every website page (the landing, the phase and tool pages, the
// 404): always dark, the shared head, header and footer.
// - <html data-theme="dark">: Expressive Code picks its code theme by it.
// - <main data-pagefind-body>: website pages join the docs in the site
//   search (once any page carries it, Pagefind indexes only those pages).
import HeadCommon from "../components/site/HeadCommon.astro"
import SiteHeader from "../components/site/SiteHeader.astro"
import SiteFooter from "../components/site/SiteFooter.astro"
import "../styles/tokens.css"
import "../styles/website.css"

interface Props {
  title: string
  description?: string
  /** false keeps the page out of the Pagefind index (404). */
  search?: boolean
}

const { title, description, search = true } = Astro.props
const fullTitle = title === "Miragon AI" ? title : `${title} | Miragon AI`
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Miragon AI" />
    <HeadCommon />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header-bar">
      <div class="site-header-inner">
        <SiteHeader />
      </div>
    </header>
    <main id="main" data-pagefind-body={search ? "" : undefined}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .site-header-bar {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--site-header-height);
    border-bottom: 1px solid var(--site-divider);
    background: var(--site-bg);
  }
  .site-header-inner {
    max-width: 1152px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
  }
  .skip-link {
    position: absolute;
    left: -9999px;
  }
  .skip-link:focus {
    left: 16px;
    top: 16px;
    z-index: 50;
    padding: 8px 16px;
    background: var(--cd-weiss);
    color: var(--cd-schwarz);
  }
</style>
